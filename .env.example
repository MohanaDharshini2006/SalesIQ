# ─── AI Providers ─────────────────────────────────────────────────────────────
# Primary AI: Groq (free, fast — get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Fallback AI: Google Gemini Flash (get key at https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Shopify ───────────────────────────────────────────────────────────────────
# Your Shopify store domain (format: yourstore.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin API access token (Apps > Develop > Admin API)
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here

# ─── Server (optional) ────────────────────────────────────────────────────────
# PORT=3001
